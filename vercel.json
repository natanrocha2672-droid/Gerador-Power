{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "server.js", "use": "@vercel/node", "config": { "includeFiles": "data/**" } }
  ],
  "rewrites": [
    { "source": "/", "destination": "/curso-completo.html" },
    { "source": "/curso", "destination": "/curso-completo.html" },
    { "source": "/gerador", "destination": "/gerador.html" },
    { "source": "/api/:path*", "destination": "/server.js" }
  ]
}
