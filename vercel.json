{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "data/*.json", "use": "@vercel/static" },
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "data/curso-extraido.json",
          "course-data.generated.js"
        ]
      }
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/curso", "destination": "/index.html" },
    { "source": "/gerador", "destination": "/gerador.html" },
    { "source": "/api/:path*", "destination": "/server.js" }
  ]
}
